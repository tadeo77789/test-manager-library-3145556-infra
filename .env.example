# Copy to .env and adjust. Example values only: never commit a real .env.

# Database (the db service in docker-compose.yml uses the same values)
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=library

# Authentication
JWT_SECRET=change-me-to-a-long-random-string

# Initial administrator, created by the API on startup if it does not exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Covers storage inside the API container
COVERS_DIR=/var/www/html/storage/covers

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Days added to the API clock (0 = real time). Use -20 to create overdue loans for the demo seeder
CLOCK_OFFSET_DAYS=0
